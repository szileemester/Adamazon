rules_version = '2';

// Only e-mail addresses listed in /allowedUsers may read or write anything.
// New users are added by hand in the Firebase console (document id = lowercase e-mail).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function allowed() {
      return signedIn() &&
        exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    match /allowedUsers/{email} {
      allow read: if signedIn() && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    match /{collection}/{docId} {
      allow read, write: if allowed() && collection in ['categories', 'stores', 'learned', 'cards'];
    }

    match /stores/{storeId}/items/{itemId} {
      allow read, write: if allowed();
    }

    match /cards/{cardId}/images/{side} {
      allow read, write: if allowed();
    }
  }
}
