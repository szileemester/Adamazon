rules_version = '2';

// Only e-mail addresses listed in /allowedUsers may read or write anything, and only inside their
// own group: allowedUsers/{lowercase e-mail}.groupId names a document in /groups, and everything a
// household shares lives under it. Groups and members are managed by hand in the Firebase console.
//
// Writes are also validated: only the fields the app uses, with sane types and sizes, so a bug
// or a damaged client cannot fill the shared data with junk. Keep in sync with data/Repositories.kt.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function allowed() {
      return signedIn() && exists(/databases/$(database)/documents/allowedUsers/$(myEmail()));
    }

    function myGroup() {
      return get(/databases/$(database)/documents/allowedUsers/$(myEmail())).data.get('groupId', '');
    }

    function inGroup(g) {
      return allowed() && myGroup() != '' && myGroup() == g;
    }

    // The data from before groups existed stays readable, for the one-time copy into the group
    // that is flagged with legacyImport. Nobody can write it any more.
    function legacyReader() {
      return allowed() && myGroup() != '' &&
        get(/databases/$(database)/documents/groups/$(myGroup())).data.get('legacyImport', false) == true;
    }

    // --- field helpers (d = the document as it will look after the write) ---

    function str(d, f, minLen, maxLen) {
      return f in d && d[f] is string && d[f].size() >= minLen && d[f].size() <= maxLen;
    }

    function optStr(d, f, maxLen) {
      return !(f in d) || d[f] == null || (d[f] is string && d[f].size() <= maxLen);
    }

    function optInt(d, f) {
      return !(f in d) || d[f] == null || d[f] is int;
    }

    function optBytes(d, f, maxBytes) {
      return !(f in d) || (d[f] is bytes && d[f].size() <= maxBytes);
    }

    // --- documents ---

    function validCategory(d) {
      return d.keys().hasOnly(['name', 'emoji', 'sortIndex']) &&
        str(d, 'name', 1, 50) && str(d, 'emoji', 0, 16) && d.sortIndex is int;
    }

    function validStore(d) {
      return d.keys().hasOnly(['name', 'domain', 'description', 'colorArgb', 'logo', 'sortIndex',
                               'orderLocked', 'categoryScores', 'session']) &&
        str(d, 'name', 1, 60) &&
        optStr(d, 'domain', 200) &&
        optStr(d, 'description', 255) &&
        optInt(d, 'colorArgb') && optInt(d, 'sortIndex') &&
        (!('orderLocked' in d) || d.orderLocked is bool) &&
        optBytes(d, 'logo', 200 * 1024) &&
        (!('categoryScores' in d) || d.categoryScores is map) &&
        (!('session' in d) || d.session is map);
    }

    function validItem(d) {
      return d.keys().hasOnly(['name', 'quantity', 'categoryId', 'emoji', 'checked', 'checkedAt',
                               'createdAt', 'createdBy']) &&
        str(d, 'name', 1, 500) &&
        optStr(d, 'quantity', 50) &&
        str(d, 'categoryId', 0, 100) &&
        str(d, 'emoji', 0, 16) &&
        d.checked is bool &&
        optInt(d, 'checkedAt') && optInt(d, 'createdAt') &&
        optStr(d, 'createdBy', 200);
    }

    function validLearned(d) {
      return d.keys().hasOnly(['displayName', 'categoryId', 'emoji']) &&
        str(d, 'displayName', 1, 500) && str(d, 'categoryId', 0, 100) && str(d, 'emoji', 0, 16);
    }

    function validCard(d) {
      return d.keys().hasOnly(['name', 'storeId', 'sortIndex', 'thumb', 'barcodeValue', 'barcodeFormat']) &&
        str(d, 'name', 1, 100) &&
        optStr(d, 'storeId', 100) &&
        optInt(d, 'sortIndex') &&
        optBytes(d, 'thumb', 150 * 1024) &&
        optStr(d, 'barcodeValue', 4000) &&
        optStr(d, 'barcodeFormat', 30);
    }

    function validCardImage(d) {
      return d.keys().hasOnly(['data']) && d.data is bytes && d.data.size() <= 950 * 1024;
    }

    // --- access ---

    match /allowedUsers/{email} {
      // Your own entry, and your group's members (the member list in Settings).
      allow read: if signedIn() && (myEmail() == email ||
        (resource.data.get('groupId', '') != '' && inGroup(resource.data.groupId)));
      allow write: if false;
    }

    match /groups/{g} {
      allow read: if inGroup(g);
      // Members only mark the legacy copy as done; groups are created and named in the console.
      allow update: if inGroup(g) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['migratedAt']) &&
        request.resource.data.migratedAt is int;
      allow create, delete: if false;

      match /categories/{id} {
        allow read: if inGroup(g);
        allow create, update: if inGroup(g) && validCategory(request.resource.data);
        // "Egyéb" is the fallback for unknown categories and must always exist.
        allow delete: if inGroup(g) && id != 'egyeb';
      }

      match /stores/{storeId} {
        allow read, delete: if inGroup(g);
        allow create, update: if inGroup(g) && validStore(request.resource.data);

        match /items/{itemId} {
          allow read, delete: if inGroup(g);
          allow create, update: if inGroup(g) && validItem(request.resource.data);
        }
      }

      match /learned/{id} {
        allow read, delete: if inGroup(g);
        allow create, update: if inGroup(g) && validLearned(request.resource.data);
      }

      match /cards/{cardId} {
        allow read, delete: if inGroup(g);
        allow create, update: if inGroup(g) && validCard(request.resource.data);

        match /images/{side} {
          allow read, delete: if inGroup(g);
          allow create, update: if inGroup(g) && side in ['front', 'back'] && validCardImage(request.resource.data);
        }
      }
    }

    // --- pre-group data: read-only, see legacyReader() ---

    match /categories/{id} {
      allow read: if legacyReader();
    }

    match /stores/{storeId} {
      allow read: if legacyReader();

      match /items/{itemId} {
        allow read: if legacyReader();
      }
    }

    match /learned/{id} {
      allow read: if legacyReader();
    }

    match /cards/{cardId} {
      allow read: if legacyReader();

      match /images/{side} {
        allow read: if legacyReader();
      }
    }
  }
}
